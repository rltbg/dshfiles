{
  "name": "@dshfiles/sandboxes",
  "version": "0.1.0",
  "private": true,
  "description": "Per-thread sandboxes: creates, starts, stops and destroys hardened containers whose workspace a thread works in, copies the project in with git and its changes back after every turn.",
  "license": "MIT",
  "files": [
    "dist",
    "image",
    "cordis.patch.yml",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./api": {
      "types": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "dshx build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "dependencies": {
    "@dshfiles/git-cli": "workspace:*",
    "@dshfiles/sandbox-guest": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.2-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-storage-json": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@dshfiles/sandbox-seams": "workspace:*",
    "@dshfiles/subprocess-local": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@dshfiles/sandbox-seams": "0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "host": {
      "inject": [
        "@deepseek-ai/dsh-home-paths",
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/dsh-workspace"
      ]
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
